@page "/"
@using CSEInvestmentTool.Domain.Models
@using CSEInvestmentTool.Application.Services
@using CSEInvestmentTool.Application.Interfaces
@using CSEInvestmentTool.Application.Models
@using CSEInvestmentTool.Web.Helpers
@using CSEInvestmentTool.Domain.Constants
@using System.Threading.Tasks
@inject ILogger<Index> Logger
@inject IStockScoreRepository ScoreRepository
@inject IInvestmentAllocationService AllocationService
@inject IInvestmentRecommendationRepository RecommendationRepository
@inject IStockRepository StockRepository
@inject NavigationManager Navigation

<div class="space-y-6">
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Investment Dashboard</h1>
            <p class="mt-1 text-sm text-gray-500">Generate investment recommendations using Algorithm or AI</p>
        </div>
        <div class="flex items-center space-x-4">
            <!-- Sector Filter -->
            <div class="flex items-center space-x-2">
                <label class="text-sm font-medium text-gray-700">Sector:</label>
                <select @bind="_selectedSector" @bind:after="OnSectorChanged" disabled="@(_loading || _methodSwitching)"
                        class="block w-40 pl-3 pr-8 py-2 text-sm border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 rounded-md disabled:opacity-50 disabled:cursor-not-allowed">
                    <option value="">All Sectors</option>
                    @foreach (var sector in _availableSectors)
                    {
                        <option value="@sector">@sector</option>
                    }
                </select>
            </div>

            <!-- Method Selection -->
            <div class="flex items-center space-x-2">
                <label class="text-sm font-medium text-gray-700">Method:</label>
                <select @bind="_selectedMethodString" @bind:after="OnMethodChanged" disabled="@(_loading || _methodSwitching)"
                        class="block w-32 pl-3 pr-8 py-2 text-sm border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 rounded-md disabled:opacity-50 disabled:cursor-not-allowed">
                    <option value="Algorithm">Algorithm</option>
                    <option value="AI">AI Analysis</option>
                </select>
            </div>

            <!-- AI Philosophy (only shown when AI is selected) -->
            @if (_selectedMethodString == "AI")
            {
                <div class="flex items-center space-x-2">
                    <label class="text-sm font-medium text-gray-700">Philosophy:</label>
                    <select @bind="_selectedPhilosophy" disabled="@(_loading || _methodSwitching)"
                            class="block w-40 pl-3 pr-8 py-2 text-sm border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 rounded-md disabled:opacity-50 disabled:cursor-not-allowed">
                        <option value="@InvestmentPhilosophyType.ValueInvesting">Value Investing</option>
                        <option value="@InvestmentPhilosophyType.GrowthInvesting">Growth Investing</option>
                        <option value="@InvestmentPhilosophyType.DividendInvesting">Dividend Focus</option>
                        <option value="@InvestmentPhilosophyType.BalancedApproach">Balanced</option>
                        <option value="@InvestmentPhilosophyType.Conservative">Conservative</option>
                    </select>
                </div>
            }

            <button @onclick="GenerateRecommendations" disabled="@(_loading || _methodSwitching)"
                    class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-gray-400">
                @if (_loading)
                {
                    <span class="mr-2">⏳</span>
                    <span>@(_selectedMethodString == "AI" ? "AI Analyzing..." : "Calculating...")</span>
                }
                else if (_methodSwitching)
                {
                    <span class="mr-2">🔄</span>
                    <span>Switching...</span>
                }
                else
                {
                    <span class="mr-2">@(_selectedMethodString == "AI" ? "🤖" : "📊")</span>
                    <span>Generate @(_selectedMethodString == "AI" ? "AI" : "Algorithm") Recommendations</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error</h3>
                    <p class="text-sm text-red-700 mt-1">@_errorMessage</p>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="bg-green-50 border-l-4 border-green-400 p-4 rounded">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-green-700">@_successMessage</p>
                </div>
            </div>
        </div>
    }

    @if (_methodSwitching)
    {
        <div class="flex justify-center items-center h-32">
            <div class="text-center">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 mx-auto"></div>
                <p class="mt-2 text-sm text-gray-600">Switching analysis method...</p>
            </div>
        </div>
    }
    else if (_loading)
    {
        <div class="flex justify-center items-center h-32">
            <div class="text-center">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 mx-auto"></div>
                <p class="mt-2 text-sm text-gray-600">
                    @(_selectedMethodString == "AI" ? "AI is analyzing your stocks..." : "Calculating algorithm scores...")
                </p>
                @if (_selectedMethodString == "AI")
                {
                    <p class="mt-1 text-xs text-gray-500">This may take 1-2 minutes for comprehensive analysis</p>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Stats Section -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="bg-blue-50 rounded-lg p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500">Monthly Budget</p>
                        <p class="text-2xl font-bold text-blue-700 mt-1">
                            LKR @_monthlyInvestmentAmount.ToString("N0")
                        </p>
                    </div>
                    <div>
                        <button @onclick="OpenBudgetModal" disabled="@(_loading || _methodSwitching)"
                                class="h-10 w-10 bg-blue-100 rounded-full flex items-center justify-center hover:bg-blue-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <div class="bg-green-50 rounded-lg p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500">Recommendation Method</p>
                        <p class="text-xl font-bold text-green-700 mt-1">
                            @(_selectedMethodString == "AI" ? "🤖 AI Analysis" : "📊 Algorithm")
                        </p>
                        @if (_selectedMethodString == "AI")
                        {
                            <p class="text-xs text-green-600">@_selectedPhilosophy.ToString().Replace("Investing", "")</p>
                        }
                    </div>
                </div>
            </div>

            <div class="bg-purple-50 rounded-lg p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500">Recommended Stocks</p>
                        <p class="text-2xl font-bold text-purple-700 mt-1">
                            @_filteredRecommendations.Count
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-orange-50 rounded-lg p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500">Selected Sector</p>
                        <p class="text-lg font-bold text-orange-700 mt-1">
                            @(string.IsNullOrEmpty(_selectedSector) ? "All" : _selectedSector)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @if (_filteredRecommendations?.Any() == true)
        {
            <!-- Method Mismatch Warning -->
            @if (_currentRecommendationMethod != null && _currentRecommendationMethod != _selectedMethodString)
            {
                <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded mb-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-yellow-700">
                                <strong>Method Mismatch:</strong> You've selected <strong>@_selectedMethodString</strong> method, but showing <strong>@_currentRecommendationMethod</strong> recommendations from @_lastRecommendationDate?.ToString("MMM dd, yyyy").
                                <button @onclick="GenerateRecommendations" disabled="@(_loading || _methodSwitching)"
                                        class="text-indigo-600 hover:text-indigo-800 underline focus:outline-none ml-1 disabled:text-gray-400 disabled:cursor-not-allowed">
                                    Generate new @_selectedMethodString recommendations
                                </button>
                            </p>
                        </div>
                    </div>
                </div>
            }

            <div class="bg-white rounded-lg shadow">
                <div class="px-6 py-4 border-b border-gray-200">
                    <div class="flex justify-between items-center">
                        <h2 class="text-lg font-medium text-gray-900">
                            Investment Recommendations
                            @if (_currentRecommendationMethod == "AI")
                            {
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                                    🤖 AI Generated (@_selectedPhilosophy.ToString().Replace("Investing", ""))
                                </span>
                            }
                            else
                            {
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    📊 Algorithm Based
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(_selectedSector))
                            {
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                    📂 @_selectedSector
                                </span>
                            }
                            @if (_lastRecommendationDate.HasValue)
                            {
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                    📅 @_lastRecommendationDate.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                        </h2>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Allocation</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reason</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var recommendation in _filteredRecommendations)
                            {
                                <tr class="hover:bg-gray-50 cursor-pointer" @onclick="() => NavigateToStockDetails(recommendation.StockId)">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div>
                                                <div class="text-sm font-medium text-gray-900">@recommendation.Stock?.Symbol</div>
                                                <div class="text-sm text-gray-500">@recommendation.Stock?.CompanyName</div>
                                                <div class="text-xs text-gray-400">@recommendation.Stock?.Sector</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-gray-900">
                                            LKR @recommendation.RecommendedAmount.ToShortForm()
                                            <span class="text-xs text-gray-500 block">(@recommendation.RecommendedAmount.ToString("N0"))</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm text-gray-900 max-w-xs">
                                            @recommendation.RecommendationReason
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <button @onclick="() => NavigateToStockDetails(recommendation.StockId)" @onclick:stopPropagation="true"
                                                class="text-indigo-600 hover:text-indigo-900">
                                            View Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded">
                <div class="flex">
                    <div class="ml-3">
                        <p class="text-sm text-yellow-700">
                            @if (!string.IsNullOrEmpty(_selectedSector))
                            {
                                <span>No recommendations available for @_selectedSector sector.</span>
                            }
                            else
                            {
                                <span>No recommendations available. Generate your first analysis to get started!</span>
                            }
                            <button @onclick="GenerateRecommendations" disabled="@(_loading || _methodSwitching)"
                                    class="text-indigo-600 hover:text-indigo-800 underline focus:outline-none ml-1 disabled:text-gray-400 disabled:cursor-not-allowed">
                                Generate @(_selectedMethodString == "AI" ? "AI" : "Algorithm") Recommendations
                            </button>
                        </p>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Budget Modal -->
    @if (_showBudgetModal)
    {
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 p-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-medium text-gray-900">Update Monthly Investment Budget</h3>
                    <button @onclick="CloseBudgetModal" class="text-gray-400 hover:text-gray-500">
                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <div class="mb-4">
                    <label for="monthlyBudget" class="block text-sm font-medium text-gray-700">Monthly Budget (LKR)</label>
                    <input type="number" id="monthlyBudget"
                           @bind="_newMonthlyAmount"
                           class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                    @if (!string.IsNullOrEmpty(_budgetErrorMessage))
                    {
                        <p class="mt-2 text-sm text-red-600">@_budgetErrorMessage</p>
                    }
                </div>
                <div class="flex justify-end space-x-3">
                    <button @onclick="CloseBudgetModal"
                            class="inline-flex justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        Cancel
                    </button>
                    <button @onclick="UpdateBudget"
                            class="inline-flex justify-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                        Update Budget
                    </button>
                </div>
            </div>
        </div>
    }
</div>